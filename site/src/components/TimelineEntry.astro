---
import type { CollectionEntry } from 'astro:content';
import { PARTICIPANT_DISPLAY, FORMAT_LABELS } from '~/lib/constants';

interface Props {
  entry: CollectionEntry<'dialogues'>;
}
const { entry } = Astro.props;
const { title, recordedAt, format, participants, state } = entry.data;
---
<li class="timeline-item" data-state={state}>
  <a
    href={`/dialogues/${entry.slug}/`}
    class="block no-underline text-[var(--fg)] border border-[var(--border)] corner-asym-lg px-5 py-4 transition-[box-shadow,background-color] duration-200 hover:bg-[var(--ignis-tint)] hover:shadow-[var(--shadow-card-hover)]"
  >
    <div class="flex items-start gap-3 mb-1">
      <h3 class="font-mincho text-md flex-1">{title}</h3>
      <span class="inline-block bg-[var(--ignis-tint)] text-[var(--primary)] text-xs px-3 py-1 corner-asym-full whitespace-nowrap">
        {FORMAT_LABELS[format]}
      </span>
    </div>
    <p class="text-sm text-[var(--muted)] mb-1">
      {participants.map((p) => PARTICIPANT_DISPLAY[p] ?? p).join(' ↔ ')}
    </p>
    <time datetime={recordedAt} class="text-xs text-[var(--muted)]">{recordedAt}</time>
  </a>
</li>
