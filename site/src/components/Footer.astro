    <span>&copy; {year} {AUTHOR_DISPLAY}</span>
    <nav class="flex gap-4">
      <a href="/dialogues/archive/">dialogues archive</a>
      <a href="https://github.com/samejima-ai/ai-tetsugaku" rel="noopener noreferrer">repo</a>
    </nav>
  </div>
</footer>
