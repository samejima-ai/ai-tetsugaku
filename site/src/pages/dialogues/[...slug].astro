---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { PARTICIPANT_DISPLAY, FORMAT_LABELS } from '~/lib/constants';
import { isPublic } from '~/lib/visibility';

export async function getStaticPaths() {
  const entries = await getCollection('dialogues', ({ data }) => isPublic(data));
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'dialogues'>;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, recordedAt, publishedAt, participants, format } = entry.data;
---
<BaseLayout title={title}>
  <nav class="text-sm text-[var(--muted)] mb-4">
    <a href="/dialogues/">対話篇</a>
  </nav>
  <h1 class="font-mincho text-2xl mb-2">{title}</h1>
  <div class="text-sm text-[var(--muted)] mb-2 flex flex-wrap items-center gap-2">
    <time datetime={recordedAt}>記録: {recordedAt}</time>
    <span>·</span>
    <time datetime={publishedAt}>公開: {publishedAt}</time>
    <span>·</span>
    <span class="inline-block bg-[var(--ignis-tint)] text-[var(--primary)] text-xs px-3 py-1 corner-asym-full">
      {FORMAT_LABELS[format]}
    </span>
  </div>
  <p class="text-sm text-[var(--muted)] mb-6">
    {participants.map((p) => PARTICIPANT_DISPLAY[p] ?? p).join(' ↔ ')}
  </p>
  <hr class="border-[var(--border)] mb-8" />
  <article class="prose-article">
    <Content />
  </article>
</BaseLayout>
