---
import BaseLayout from '~/layouts/BaseLayout.astro';
import DialogueEntry from '~/components/DialogueEntry.astro';
import { getCollection } from 'astro:content';
import { isPublic } from '~/lib/visibility';

const dialogues = (await getCollection('dialogues', ({ data }) => isPublic(data)))
  .sort((a, b) => b.data.recordedAt.localeCompare(a.data.recordedAt));
---
<BaseLayout title="dialogues archive">
  <h1 class="font-mincho text-2xl mb-6">dialogues archive</h1>
  <p class="text-sm text-[var(--muted)] mb-8">
    全対話の単純な一覧。流れを縦に追うなら <a href="/dialogues/">対話篇（思考の河）</a> から。
  </p>
  {dialogues.length === 0 ? (
    <p class="text-base text-[var(--muted)]">まだ公開された対話はありません。</p>
  ) : (
    <div class="space-y-4">
      {dialogues.map((entry) => <DialogueEntry entry={entry} />)}
    </div>
  )}
</BaseLayout>
