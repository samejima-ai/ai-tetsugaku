---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PortalCard from '~/components/PortalCard.astro';
import { getCollection } from 'astro:content';
import { SITE_NAME_DISPLAY, SITE_TAGLINE } from '~/lib/constants';
import { isPublic } from '~/lib/visibility';

const dialogues = await getCollection('dialogues', ({ data }) => isPublic(data));
const crystals = await getCollection('philosophy', ({ data }) => isPublic(data));
---
<BaseLayout>
  <section class="mb-12">
    <h1 class="font-mincho text-3xl mb-3">{SITE_NAME_DISPLAY}</h1>
    <p class="text-base text-[var(--muted)]">{SITE_TAGLINE}</p>
  </section>

  <section class="grid gap-5 mb-12">
    <PortalCard
      variant="dialogue"
      href="/dialogues/"
      label="対話篇 — dialogues"
      title="思考の河"
      description="かげろう と Ignis の対話。流れそのもの。縦に降りる時系列で読む。"
      meta={`${dialogues.length} 篇`}
    />
    <PortalCard
      variant="crystal"
      href="/philosophy/"
      label="結晶篇 — philosophy"
      title="飛び石"
      description="流れのなかで思考が節目に達したとき打たれる結晶。テーマで配置。"
      meta={`${crystals.length} 篇`}
    />
  </section>

  <section>
    <p class="text-sm text-[var(--muted)]">
      この場と かげろう について →{' '}
      <a href="/about/">about</a>
    </p>
  </section>
</BaseLayout>
