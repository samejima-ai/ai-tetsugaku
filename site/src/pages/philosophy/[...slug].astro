---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { isPublic } from '~/lib/visibility';

export async function getStaticPaths() {
  const entries = await getCollection('philosophy', ({ data }) => isPublic(data));
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'philosophy'>;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description, publishedAt, tags } = entry.data;
---
<BaseLayout title={title} description={description}>
  <nav class="text-sm text-[var(--muted)] mb-4">
    <a href="/philosophy/">philosophy</a>
  </nav>
  <h1 class="font-mincho text-2xl mb-2">{title}</h1>
  <div class="text-sm text-[var(--muted)] mb-6">
    <time datetime={publishedAt}>{publishedAt}</time>
    {tags && tags.length > 0 && (
      <span class="ml-2">{tags.map((t) => `#${t}`).join(' ')}</span>
    )}
  </div>
  <hr class="border-[var(--border)] mb-8" />
  <article class="prose-article">
    <Content />
  </article>
</BaseLayout>

<style>
  .prose-article :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.85;
  }
  .prose-article :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-family: 'Shippori Mincho', 'Noto Serif JP', Georgia, serif;
    font-size: 1.728rem;
    line-height: 1.4;
  }
  .prose-article :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-family: 'Shippori Mincho', 'Noto Serif JP', Georgia, serif;
    font-size: 1.44rem;
    line-height: 1.4;
  }
  .prose-article :global(blockquote) {
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--muted);
  }
  .prose-article :global(code) {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    background-color: var(--ignis-tint);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    font-size: 0.9em;
  }
</style>
