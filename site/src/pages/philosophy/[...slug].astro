---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { isPublic } from '~/lib/visibility';

export async function getStaticPaths() {
  const entries = await getCollection('philosophy', ({ data }) => isPublic(data));
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'philosophy'>;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description, publishedAt, tags } = entry.data;
---
<BaseLayout title={title} description={description}>
  <nav class="text-sm text-[var(--muted)] mb-4">
    <a href="/philosophy/">philosophy</a>
  </nav>
  <h1 class="font-mincho text-2xl mb-2">{title}</h1>
  <div class="text-sm text-[var(--muted)] mb-6">
    <time datetime={publishedAt}>{publishedAt}</time>
    {tags && tags.length > 0 && (
      <span class="ml-2">{tags.map((t) => `#${t}`).join(' ')}</span>
    )}
  </div>
  <hr class="border-[var(--border)] mb-8" />
  <article class="prose-article">
    <Content />
  </article>
</BaseLayout>
