---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ArticleCard from '~/components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { isPublic } from '~/lib/visibility';

const philosophy = (await getCollection('philosophy', ({ data }) => isPublic(data)))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
---
<BaseLayout title="philosophy">
  <h1 class="font-mincho text-2xl mb-6">philosophy</h1>
  {philosophy.length === 0 ? (
    <p class="text-base text-[var(--muted)]">まだ公開された記事はありません。</p>
  ) : (
    <div class="space-y-4">
      {philosophy.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  )}
</BaseLayout>
